{
  // ---------------------------------------------------------------------------
  // Copy this file to `config.json` and fill in the selectors for YOUR app and
  // for Google Voice. Comments (// and /* */) are allowed in this file.
  //
  // How to find selectors quickly:
  //   npm run codegen -- https://your-app.example.com
  //   npm run codegen -- https://voice.google.com
  // Click the element you care about; Playwright shows you a selector to paste
  // below. Each field accepts a single selector string OR an array of
  // candidates that are tried in order (handy when a UI changes).
  // ---------------------------------------------------------------------------

  // The first page to open: your app's home/dashboard that shows the folders.
  "homeUrl": "https://your-app.example.com/home",

  "browser": {
    // "chrome" drives your real installed Google Chrome (recommended on macOS).
    "channel": "chrome",
    // A folder for the persistent profile. You log in by hand ONCE; the session
    // is remembered here for future runs. No passwords are stored by this tool.
    "userDataDir": "./chrome-profile",
    // Must be true for real use so you can watch it and so it looks like normal
    // browsing.
    "headed": true
  },

  "site": {
    // Links on the home page that open each folder/list of members.
    "folderLinks": "a.folder-link",
    // Links on a folder page that open an individual member.
    "memberLinks": "a.member-link",
    // Where the member's name is shown on their page.
    "memberName": "h1.member-name",
    // Where the phone number is shown. If a member has only an email, this
    // selector should match nothing on their page (that's how email-only
    // members are detected and skipped).
    "memberPhone": ".member-phone",
    // The page's "copy initial message" button.
    "copyMessageButton": "button:has-text('copy initial message')",

    // OPTIONAL — the "did you reach out?" survey. Remove these three keys if
    // your pages don't have it.
    "surveyReachedOutYes": "input[name='reached'][value='yes']",
    "surveySubmit": "button:has-text('Save')",
    "surveySavedIndicator": "text=Saved"
  },

  "googleVoice": {
    "url": "https://voice.google.com/u/0/messages",
    "selectors": {
      "composeButton": ["[aria-label='Send new message']", "text=Send new message"],
      "recipientInput": ["input[aria-label='Type a name or phone number']", "input[placeholder*='phone']"],
      "messageInput": ["textarea[aria-label='Type a message']", "[contenteditable='true']"],
      "sendButton": ["[aria-label='Send message']", "button:has-text('Send')"],
      // Optional element that confirms the message was sent.
      "sentIndicator": "text=Sent"
    }
  },

  "pacing": {
    // Pauses make the activity look human. Tune to taste.
    "actionDelayMs": [600, 1800],
    "keystrokeDelayMs": [55, 160],
    // Gap between finishing one member and starting the next (seconds).
    "betweenMembersSec": [25, 95],
    // Optional: only send during these local hours (24h). Outside, it waits.
    "activeHours": { "start": 9, "end": 20 }
  },

  "limits": {
    // Keep these conservative. Google Voice has daily limits and flags bursts.
    "maxPerRun": 25,
    "maxPerDay": 50
  },

  "behavior": {
    "skipEmailOnly": true,
    "fillSurvey": true,
    "randomizeOrder": true
  },

  // Local audit log so nobody is ever texted twice. Stays on your machine.
  "contactLogPath": "./data/contact-log.json"
}
